# ---------------------------------------------------------
# Yeelux Configuration File
# ---------------------------------------------------------

# [Server Port]
# The port on which the local web interface runs.
PORT=5000

# [Development Mode]
# Set to 'true' to enable Flask's debug mode and hot-reloading.
# WARNING: Do NOT set to 'true' in production or on mobile devices (e.g., Termux)
# as it spawns a secondary watchdog process and consumes significant battery/memory.
FLASK_DEBUG=false

# [mDNS Fallback Polling]
# The interval (in seconds) for active IP polling.
# This is only used if native OS passive event listening (Netlink) is unavailable.
# A higher value saves battery; 180 seconds (3 minutes) is recommended.
MDNS_POLLING_INTERVAL=180

# [mDNS Custom Name]
# (Optional) Force override the mDNS broadcast name (default is yeelux).
# Useful to prevent conflicts if running multiple instances in the same network.
# e.g., MDNS_NAME=yeelux-bedroom (makes it accessible via http://yeelux-bedroom.local:5000)
# MDNS_NAME=yeelux

